# Supabase (required)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Mapbox — browser maps need the **web** token (pk.*), not the native token.
# Put local overrides in .env.local (gitignored). Restart `npm run dev` after changes (port 8080).
#
# Option A (production / Lovable): set MAPBOX_WEB_TOKEN on Supabase; maps load via get-mapbox-token.
# Option B (local dev): paste the same web pk token in .env.local:
# VITE_MAPBOX_WEB_TOKEN=pk.eyJ...
#
# VITE_MAPBOX_PUBLIC_TOKEN (if present in .env) is NOT used for admin maps — native token → 403 in browser.

# ---------------------------------------------------------------------------
# Driver identity re-verification (Veriff Selfie2Selfie) — Edge Function secrets
# Local authoring only. Do NOT configure a production Veriff webhook or deploy
# without explicit release approval. Configure via `supabase secrets set` when
# deploying to a non-production project for SE-enabled Selfie2Selfie testing.
# ---------------------------------------------------------------------------
# VERIFF_API_KEY=
# VERIFF_SHARED_SECRET=
# Optional base URL override for the SE-enabled Selfie2Selfie integration:
# VERIFF_SELFIE2SELFIE_BASE_URL=
# VERIFF_API_BASE_URL=
# Optional workflow id if the SE provides one:
# VERIFF_SELFIE2SELFIE_WORKFLOW_ID=
